generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//-----------------CORE ENTITIES-----------------//

model Workspace {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  users         User[]
  integrations  Integration[]
  subscriptions Subscription[]
}

model User {
  id          String   @id @default(cuid())
  clerkId     String   @unique
  email       String   @unique
  name        String?
  workspaceId String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

//-----------------SAAS CATALOG (GLOBAL)-----------------//

model SaasApplication {
  id       String  @id @default(cuid())
  name     String  @unique
  vendor   String?
  category String?
  logoUrl  String?
  website  String?

  // MVP: static cancellation guidance
  cancellationGuide String? @db.Text
  cancellationUrl   String?

  subscriptions Subscription[]

  createdAt DateTime @default(now())
}

//-----------------SUBSCRIPTIONS-----------------//

model Subscription {
  id          String   @id @default(cuid())
  workspaceId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  saasApplicationId String?
  saasApplication   SaasApplication? @relation(fields: [saasApplicationId], references: [id])

  // Display & cost
  displayName  String
  amount       Decimal      @db.Decimal(10, 2)
  currency     String       @default("MYR")
  billingCycle BillingCycle @default(MONTHLY)
  category     String?

  // Status & optimization
  status   SubscriptionStatus @default(ACTIVE)
  isUnused Boolean            @default(false)

  // Detection metadata (ADDED)
  detectedVia    DetectionMethod @default(MANUAL)
  lastDetectedAt DateTime        @default(now())
  confidence     Int? // 0-100 score from scanner
  sourceEmail    String? // Email address it was detected from

  // User confirmation (ADDED)
  isConfirmed Boolean @default(false)

  // Unique constraint: one subscription per service per workspace
  @@unique([workspaceId, displayName])
  @@index([workspaceId])
  @@index([status])
}

//-----------------INTEGRATIONS-----------------//

model Integration {
  id          String   @id @default(cuid())
  workspaceId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  type   IntegrationType
  status IntegrationStatus @default(CONNECTED)

  // OAuth tokens
  accessToken          String    @db.Text
  refreshToken         String?   @db.Text
  accessTokenExpiresAt DateTime?

  lastSyncAt DateTime?
  nextSyncAt DateTime?

  @@unique([workspaceId, type])
}

//-----------------ENUMS-----------------//

enum BillingCycle {
  MONTHLY
  YEARLY
  ONE_TIME
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  UNKNOWN
  PENDING // For unconfirmed detections
}

enum DetectionMethod {
  GMAIL
  MANUAL
}

enum IntegrationType {
  GMAIL
}

enum IntegrationStatus {
  CONNECTED
  DISCONNECTED
  ERROR
}
